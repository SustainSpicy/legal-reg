# CorpSignal MCP — Environment Variables
# Copy to .env and fill in your values before running

# Redis connection (required for caching)
# Railway provides this automatically; for local dev use redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Context Protocol API key (required for createContextMiddleware)
# Obtain from https://ctxprotocol.com/dashboard
CONTEXT_API_KEY=

# Companies House REST API key (required for GB entity lookups + UK PSC)
# Register free at https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=

# SEC EDGAR contact email (required by EDGAR User-Agent policy)
# Must identify a real person/organisation — EDGAR may block requests without this
EDGAR_CONTACT_EMAIL=compliance@yourdomain.com

# FinCEN Beneficial Ownership API key (required for US BOI lookups)
# Apply at https://boiefiling.fincen.gov for authorised API access
FINCEN_BOI_API_KEY=

# Server port (default: 3000)
PORT=3000
